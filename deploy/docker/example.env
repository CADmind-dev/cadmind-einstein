# Copy to deploy/docker/.env and fill in. Never commit the filled-in file.
EINSTEIN_UID=1000
EINSTEIN_GID=1000
# EINSTEIN_TAG=v0.2.0          # image tag; set it to the release you build
# AGENT_INSTALL=               # miner image only: a shell command installing your agent CLI

NETWORK=test                    # finney (mainnet), test, or a ws(s):// endpoint
NETUID=<NETUID>
PLATFORM_URL=https://cadmind.ai
WALLETS_DIR=/path/to/.bittensor/wallets

# validator
VALIDATOR_WALLET=VALIDATOR_WALLET
VALIDATOR_HOTKEY=VALIDATOR_HOTKEY_NAME
VALIDATOR_SECRETS_DIR=/path/to/validator-secrets   # desk.token, operator.key, mint.key, queue.key (0600)
VALIDATOR_STATE_DIR=/path/to/validator-state

# miner
MINER_WALLET=MINER_WALLET
MINER_HOTKEY=MINER_HOTKEY_NAME
MINER_STATE_DIR=/path/to/miner-state
VALIDATOR_URL=https://VALIDATOR_HOST
VALIDATOR_SS58=VALIDATOR_SS58
AGENT_CLI=claude

# The einstein validator as a systemd user unit (systemctl --user). Adjust the paths; keep the token
# and the operator key files mode 0600. Remove --dry-run-weights only when the validator should
# write weights and report commitments on chain.
[Unit]
Description=CADmind einstein validator
After=network-online.target

[Service]
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/cadmind-einstein/.venv/bin/cadmind-einstein \
  --state-dir %h/.local/share/cadmind-einstein --host 127.0.0.1 --port 8793 \
  --token-file %h/.config/cadmind-einstein/desk.token \
  --platform https://cadmind.ai \
  --operator-key-file %h/.config/cadmind-einstein/operator.key \
  --wallet-name VALIDATOR_WALLET --wallet-hotkey VALIDATOR_HOTKEY_NAME \
  --network test --netuid NETUID \
  --trusted-proxy 127.0.0.1 \
  --dry-run-weights
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
